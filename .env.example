# 复制为 .env 后修改（.env 不提交 git）
#   copy .env.example .env

# 目标窗口标题（可选；留空则 bind 节点绑定当前前台窗口）
NAME=

# 循环次数：0 = 无限
NUMBER=0

# DAG 模块：testcase.pyauto_run / testcase.backend_run
DAG=testcase.pyauto_run

# 模板图子目录，如 1920x1080_CN；空则用 dags/<category>/files/
PIX=

# dashboard
DASHBOARD_PORT=8765
# 1 = 启动时自动打开浏览器
DASHBOARD_OPEN=1
